---
import { Image } from "astro:assets";
import { type Project, screenshot } from "@/data/projects";

type Props = { project: Project; eager?: boolean; sizes?: string };
const {
  project,
  eager = false,
  sizes = "(min-width: 1024px) 50vw, 100vw",
} = Astro.props;
const { slug, accent, path } = project;
const img = screenshot(project.image);
const kind = img ? undefined : (project.cover ?? "api");

const mono = "font-family: var(--font-mono)";
const senders = [
  { y: 60, label: "shop", d: "0s" },
  { y: 125, label: "news", d: "1.1s" },
];
const bars = [38, 62, 46, 88, 70, 104, 92];

// Request log lines for the "api" cover.
const logs: Record<string, [string, string, number, string][]> = {
  "chatbot-platform": [
    ["POST", "/bots/myastalife/chat", 200, "312ms"],
    ["GET", "/bots", 200, "18ms"],
    ["POST", "/bots/bioskyz/kb", 201, "96ms"],
    ["PATCH", "/bots/bioskyz/stop", 200, "22ms"],
    ["POST", "/bots/myastalife/chat", 200, "288ms"],
    ["GET", "/widget.js", 200, "4ms"],
  ],
  "task-uncle": [
    ["POST", "/tasks", 201, "31ms"],
    ["GET", "/tasks?status=pending", 200, "12ms"],
    ["POST", "/push/send", 202, "48ms"],
    ["POST", "/push/send", 202, "44ms"],
    ["PATCH", "/tasks/42/done", 200, "19ms"],
    ["GET", "/tasks/42/history", 200, "9ms"],
  ],
};
const log = logs[slug] ?? [
  ["GET", "/health", 200, "2ms"],
  ["POST", "/v1/auth/login", 200, "64ms"],
  ["GET", "/v1/items", 200, "21ms"],
  ["POST", "/v1/items", 201, "37ms"],
  ["DELETE", "/v1/items/7", 204, "15ms"],
  ["GET", "/v1/items", 200, "19ms"],
];
const methodColour: Record<string, string> = {
  GET: "var(--cyan)",
  POST: "var(--cv)",
  PATCH: "#febc2e",
  DELETE: "#ff5f57",
};
---

<div
  class="cover window relative"
  style={`--cv: ${accent}`}
  transition:name={`cover-${slug}`}
>
  <div class="window-bar">
    <span class="window-dots"><i></i><i></i><i></i></span>
    <span class="truncate">{path ?? slug}</span>
  </div>
  {
    img && (
      <div class="cover-shot relative aspect-[16/10] overflow-hidden bg-[radial-gradient(circle_at_70%_20%,color-mix(in_oklab,var(--cv)_22%,transparent),transparent_65%)]">
        <Image
          src={img}
          alt={`${project.title} screenshot`}
          widths={[480, 800, 1200]}
          sizes={sizes}
          loading={eager ? "eager" : "lazy"}
          class="cover-img absolute inset-0 size-full object-cover object-top"
        />
        <span class="cover-scan" aria-hidden="true" />
      </div>
    )
  }
  {
    kind && (
  <div class="relative bg-[radial-gradient(circle_at_70%_20%,color-mix(in_oklab,var(--cv)_14%,transparent),transparent_60%)]">
    {
      kind === "mail" && (
        <svg viewBox="0 0 400 250" role="img" aria-label="Emails routed through a private alias to an inbox; spam is blocked">
          {senders.map((s) => (
            <>
              <path d={`M84 ${s.y} C120 ${s.y} 112 125 145 125`} fill="none" stroke="var(--line)" stroke-width="1.5" />
              <path class="flow" d={`M84 ${s.y} C120 ${s.y} 112 125 145 125`} fill="none" stroke="var(--cv)" stroke-width="1.5" opacity=".6" />
              <rect x="28" y={s.y - 14} width="56" height="28" rx="8" fill="var(--surface-2)" stroke="var(--line)" />
              <text x="56" y={s.y + 4} text-anchor="middle" font-size="11" fill="var(--muted)" style={mono}>{s.label}</text>
            </>
          ))}
          <path d="M84 190 C120 190 112 125 145 125" fill="none" stroke="var(--line)" stroke-width="1.5" />
          <rect x="28" y="176" width="56" height="28" rx="8" fill="var(--surface-2)" stroke="var(--line)" />
          <text x="56" y="194" text-anchor="middle" font-size="11" fill="var(--muted)" style={mono}>spam</text>

          <path d="M255 125 H316" fill="none" stroke="var(--line)" stroke-width="1.5" />
          <path class="flow" d="M255 125 H316" fill="none" stroke="var(--cv)" stroke-width="1.5" />

          <rect x="145" y="103" width="110" height="44" rx="12" fill="var(--surface)" stroke="var(--cv)" stroke-width="1.5" />
          <text x="200" y="121" text-anchor="middle" font-size="9" fill="var(--muted)" style={mono}>alias</text>
          <text x="200" y="137" text-anchor="middle" font-size="11.5" fill="var(--fg)" style={mono}>you@1as.in</text>

          <rect x="316" y="97" width="58" height="56" rx="12" fill="var(--cv)" />
          <path d="M330 117 l15 11 l15 -11 M330 117 h30 v22 h-30z" fill="none" stroke="var(--bg)" stroke-width="2" stroke-linejoin="round" />

          <g>
            <path d="M138 152 l10 10 M148 152 l-10 10" stroke="#ff5f57" stroke-width="2.4" stroke-linecap="round">
              <animate attributeName="opacity" values="0;0;1;0" keyTimes="0;0.55;0.65;1" dur="3.3s" repeatCount="indefinite" begin="0.6s" />
            </path>
          </g>

          {senders.map((s) => (
            <g>
              <rect x="-8" y="-6" width="16" height="12" rx="2" fill="var(--cv)" />
              <path d="M-8 -6 l8 6 l8 -6" fill="none" stroke="var(--bg)" stroke-width="1.4" />
              <animateMotion dur="3.3s" repeatCount="indefinite" begin={s.d} path={`M84 ${s.y} C120 ${s.y} 112 125 145 125 L255 125 L316 125`} />
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.9;1" dur="3.3s" repeatCount="indefinite" begin={s.d} />
            </g>
          ))}
          <g>
            <rect x="-8" y="-6" width="16" height="12" rx="2" fill="#ff5f57" />
            <path d="M-8 -6 l8 6 l8 -6" fill="none" stroke="var(--bg)" stroke-width="1.4" />
            <animateMotion dur="3.3s" repeatCount="indefinite" begin="0.6s" keyPoints="0;1;1" keyTimes="0;0.6;1" calcMode="linear" path="M84 190 C120 190 112 125 140 140" />
            <animate attributeName="opacity" values="0;1;1;0;0" keyTimes="0;0.08;0.55;0.62;1" dur="3.3s" repeatCount="indefinite" begin="0.6s" />
          </g>
        </svg>
      )
    }

    {
      kind === "link" && (
        <svg viewBox="0 0 400 250" role="img" aria-label="A long URL shrinking into a short link, with a click analytics chart">
          <defs>
            <clipPath id={`clip-${slug}`}>
              <rect x="30" y="34" width="340" height="40" rx="10" />
            </clipPath>
          </defs>
          <rect class="cv-long" x="30" y="34" width="340" height="40" rx="10" fill="var(--surface-2)" stroke="var(--cv)" stroke-width="1.2" />
          <g clip-path={`url(#clip-${slug})`}>
            <text class="cv-long-text" x="44" y="59" font-size="11" fill="var(--muted)" style={mono}>
              https://example.com/blog/2026/how-to-build-a-really-long-url?utm=x
            </text>
          </g>
          <text class="cv-short-text" x="44" y="59" font-size="13" fill="var(--fg)" style={mono}>
            <tspan fill="var(--cv)">n3y.in</tspan>/x
          </text>

          <text x="30" y="104" font-size="10" fill="var(--muted)" style={mono}>clicks · last 7 days</text>
          <line x1="30" y1="216" x2="370" y2="216" stroke="var(--line)" />
          {bars.map((h, i) => (
            <rect class="cv-bar" style={`--d:${i}`} x={40 + i * 47} y={216 - h} width="28" height={h} rx="5" fill="var(--cv)" opacity={0.35 + i * 0.09} />
          ))}
        </svg>
      )
    }

    {
      kind === "traffic" && (
        <svg viewBox="0 0 400 250" role="img" aria-label="A road junction whose traffic lights adapt to traffic">
          <defs>
            <clipPath id={`clip-${slug}`}>
              <rect x="0" y="0" width="400" height="250" />
            </clipPath>
          </defs>
          <g clip-path={`url(#clip-${slug})`}>
            <rect x="168" y="0" width="64" height="250" fill="var(--surface-2)" />
            <rect x="0" y="96" width="400" height="58" fill="var(--surface-2)" />
            <path d="M200 0 V96 M200 154 V250" stroke="var(--line)" stroke-width="2" stroke-dasharray="8 8" />
            <path d="M0 125 H168 M232 125 H400" stroke="var(--line)" stroke-width="2" stroke-dasharray="8 8" />
            <path d="M168 92 H232 M164 96 V154" stroke="var(--fg)" stroke-width="2" opacity=".35" />

            <rect class="car-v" x="177" y="0" width="16" height="26" rx="4" fill="var(--cv)" />
            <rect class="car-v" style="--d: 1.1s" x="177" y="0" width="16" height="26" rx="4" fill="var(--cyan)" />
            <rect class="car-h" x="0" y="133" width="28" height="15" rx="4" fill="var(--accent)" />
            <rect class="car-h" style="--d: 1s" x="0" y="133" width="28" height="15" rx="4" fill="var(--fg)" opacity=".7" />
          </g>

          <g transform="translate(246 30)">
            <rect width="22" height="58" rx="6" fill="var(--surface)" stroke="var(--line)" />
            <circle class="tl-ns-r" cx="11" cy="12" r="6" fill="#ff5f57" />
            <circle class="tl-ns-y" cx="11" cy="29" r="6" fill="#febc2e" />
            <circle class="tl-ns-g" cx="11" cy="46" r="6" fill="#28c840" />
          </g>
          <g transform="translate(132 164)">
            <rect width="22" height="58" rx="6" fill="var(--surface)" stroke="var(--line)" />
            <circle class="tl-ew-r" cx="11" cy="12" r="6" fill="#ff5f57" />
            <circle class="tl-ew-y" cx="11" cy="29" r="6" fill="#febc2e" />
            <circle class="tl-ew-g" cx="11" cy="46" r="6" fill="#28c840" />
          </g>
          <text x="282" y="210" font-size="10" fill="var(--muted)" style={mono}>density: adaptive</text>
          <text x="282" y="226" font-size="10" fill="var(--cv)" style={mono}>cycle → realtime</text>
        </svg>
      )
    }

    {
      kind === "blog" && (
        <svg viewBox="0 0 400 250" role="img" aria-label="Markdown on the left rendering into a clean blog post on the right">
          <rect x="20" y="28" width="168" height="194" rx="10" fill="var(--surface-2)" stroke="var(--line)" />
          <text x="34" y="48" font-size="9" fill="var(--muted)" style={mono}>post.md</text>
          {[
            ["# Hello, world", "var(--cv)"],
            ["Writing in **md**", "var(--fg)"],
            ["is fast & clean.", "var(--fg)"],
            ["- markdown", "var(--muted)"],
            ["- zero clutter", "var(--muted)"],
          ].map(([t, c], i) => (
            <>
              <text x="34" y={78 + i * 26} font-size="11" fill={c} style={mono}>{t}</text>
              <rect class="md-line" style={`--d:${i}`} x="32" y={66 + i * 26} width="148" height="17" fill="var(--surface-2)" />
            </>
          ))}

          <path class="flow" d="M194 125 H206" stroke="var(--cv)" stroke-width="2" />
          <path d="M202 119 l6 6 l-6 6" fill="none" stroke="var(--cv)" stroke-width="2" />

          <rect x="212" y="28" width="168" height="194" rx="10" fill="var(--surface)" stroke="var(--line)" />
          <text x="226" y="48" font-size="9" fill="var(--muted)" style={mono}>preview</text>
          <g class="md-out" style="--d:0">
            <rect x="226" y="62" width="110" height="14" rx="3" fill="var(--fg)" />
          </g>
          <g class="md-out" style="--d:1">
            <rect x="226" y="90" width="58" height="7" rx="3" fill="var(--muted)" />
            <rect x="288" y="90" width="26" height="7" rx="3" fill="var(--cv)" />
          </g>
          <g class="md-out" style="--d:2">
            <rect x="226" y="108" width="128" height="7" rx="3" fill="var(--muted)" />
          </g>
          <g class="md-out" style="--d:3">
            <circle cx="230" cy="139" r="3" fill="var(--cv)" />
            <rect x="240" y="136" width="70" height="7" rx="3" fill="var(--muted)" />
          </g>
          <g class="md-out" style="--d:4">
            <circle cx="230" cy="161" r="3" fill="var(--cv)" />
            <rect x="240" y="158" width="88" height="7" rx="3" fill="var(--muted)" />
          </g>
          <g class="md-out" style="--d:4">
            <rect x="226" y="184" width="140" height="24" rx="6" fill="color-mix(in oklab, var(--cv) 18%, transparent)" />
          </g>
        </svg>
      )
    }
    {
      kind === "api" && (
        <svg viewBox="0 0 400 250" role="img" aria-label="A live API request log">
          <circle cx="30" cy="30" r="4" fill="var(--cv)">
            <animate attributeName="opacity" values="1;0.2;1" dur="1.6s" repeatCount="indefinite" />
          </circle>
          <text x="42" y="34" font-size="10" fill="var(--muted)" style={mono}>live · tail -f access.log</text>
          {log.map(([m, url, status, ms], i) => (
            <g class="md-out" style={`--d:${i}`}>
              <rect x="20" y={52 + i * 31} width="360" height="24" rx="6" fill="var(--surface-2)" />
              <text x="32" y={68 + i * 31} font-size="10.5" font-weight="600" fill={methodColour[m] ?? "var(--fg)"} style={mono}>{m}</text>
              <text x="90" y={68 + i * 31} font-size="10.5" fill="var(--fg)" style={mono}>{url}</text>
              <text x="318" y={68 + i * 31} font-size="10.5" fill={status < 300 ? "#28c840" : "#febc2e"} style={mono} text-anchor="end">{status}</text>
              <text x="368" y={68 + i * 31} font-size="10" fill="var(--muted)" style={mono} text-anchor="end">{ms}</text>
            </g>
          ))}
        </svg>
      )
    }
  </div>
    )
  }
</div>
