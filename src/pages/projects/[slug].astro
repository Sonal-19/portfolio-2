---
import ProjectCover from "@/components/ProjectCover.astro";
import { projects } from "@/data/projects";
import Base from "@/layouts/Base.astro";

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: projects[(i + 1) % projects.length], index: i },
  }));
}

const { project: p, next, index } = Astro.props;
---

<Base title={`${p.title} · Shivam Shukla`} description={p.summary}>
  <article class="pt-28 pb-10 sm:pt-36" style={`--cv:${p.accent}`}>
    <div class="container-x">
      <a href="/#projects" data-hero-fade class="inline-flex items-center gap-2 font-mono text-xs text-muted hover:text-fg">
        <span>←</span> cd ../projects
      </a>

      <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p data-hero-fade class="label flex items-center gap-3">
            <span class="text-[var(--cv)]">{String(index + 1).padStart(2, "0")}</span>
            <span class="h-px w-10 bg-line"></span><span class="truncate">{p.kicker}</span>
          </p>
          <h1 data-wipe class="mt-5 font-display text-[clamp(2.6rem,8vw,6.5rem)] font-bold leading-[0.95] tracking-[-0.04em]">
            <span class="wipe"><span class="wipe-text">{p.title}</span><span class="wipe-block" aria-hidden="true"></span></span>
          </h1>
          <p data-hero-fade class="mt-6 max-w-2xl text-lg text-muted">{p.summary}</p>
        </div>
        <div data-hero-fade class="flex flex-wrap gap-3">
          {
            p.links.map((l, i) => (
              <a href={l.href} target="_blank" rel="noopener" class={`btn ${i === 0 ? "btn-primary" : "btn-ghost"}`} data-cursor="open">
                <span>{l.label}</span>
                <span class="arrow">↗</span>
              </a>
            ))
          }
        </div>
      </div>

      <div data-hero-fade class="group mt-12 md:mt-16">
        <ProjectCover project={p} eager sizes="(min-width: 1280px) 1200px, 100vw" />
      </div>

      <div class="mt-16 grid gap-12 md:mt-24 lg:grid-cols-[1fr_20rem] lg:gap-20">
        <div>
          <p data-reveal class="label">// overview</p>
          <div class="mt-5 space-y-5 text-[clamp(1.05rem,1.7vw,1.3rem)] leading-relaxed">
            {p.description.map((d) => <p data-lines>{d}</p>)}
          </div>

          <p data-reveal class="label mt-14">// highlights</p>
          <ul data-stagger class="mt-5 grid gap-3 sm:grid-cols-2">
            {
              p.highlights.map((h) => (
                <li class="flex gap-3 rounded-xl border border-line bg-surface p-4">
                  <span class="font-mono text-[var(--cv)]">✓</span>
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div data-reveal class="window">
            <div class="window-bar">package.json</div>
            <div class="p-5">
              <p class="label">role</p>
              <p class="mt-2 font-mono text-sm text-[var(--cv)]">{p.role}</p>
              {
                p.year && (
                  <>
                    <p class="label mt-6">year</p>
                    <p class="mt-2 font-mono text-sm">{p.year}</p>
                  </>
                )
              }
              <p class="label mt-6">stack</p>
              <div data-flip class="mt-3 flex flex-wrap gap-2 [perspective:600px]">
                {p.stack.map((s) => <span class="tag !text-fg">{s}</span>)}
              </div>
            </div>
          </div>
        </aside>
      </div>

      <a
        href={`/projects/${next.slug}`}
        data-reveal
        data-cursor="next"
        class="group mt-24 block border-t border-line pt-8 md:mt-32"
      >
        <p class="label">next project →</p>
        <p class="mt-4 font-display text-[clamp(2.2rem,7vw,5.5rem)] font-bold leading-none tracking-[-0.04em] transition-colors group-hover:text-accent">
          {next.title}
        </p>
      </a>
    </div>
  </article>
</Base>
