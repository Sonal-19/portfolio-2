---
type Props = { index: string; label: string; lines: string[]; note?: string };
const { index, label, lines, note } = Astro.props;
---

<header class="mb-12 grid gap-6 md:mb-16 md:grid-cols-[1fr_auto] md:items-end">
  <div>
    <p data-reveal class="label mb-5 flex items-center gap-3">
      <span class="text-accent">// {index}</span>
      <span class="h-px w-10 bg-line" data-draw></span>
      <span>{label}</span>
    </p>
    <h2 data-wipe class="font-display text-[clamp(2.4rem,7vw,5.5rem)] font-semibold leading-[0.98] tracking-[-0.035em]">
      {
        lines.map((l) => (
          <span class="block">
            <span class="wipe">
              <span class="wipe-text" set:html={l} />
              <span class="wipe-block" aria-hidden="true" />
            </span>
          </span>
        ))
      }
    </h2>
  </div>
  {note && <p data-reveal class="max-w-xs text-sm text-muted md:text-right">{note}</p>}
</header>
