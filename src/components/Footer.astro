---
import { profile } from "@/data/profile";

const phrase = [profile.name, profile.title, profile.facts.specialization];
---

<footer class="relative overflow-hidden border-t border-line pt-10 pb-8">
  <div class="overflow-hidden" aria-hidden="true">
    <div data-marquee class="marquee">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {phrase.map((p, i) => (
              <>
                <span class={`px-6 font-display text-[clamp(3rem,10vw,8rem)] font-bold whitespace-nowrap tracking-[-0.04em] ${i % 2 ? "text-outline" : ""}`}>
                  {p}
                </span>
                <span class="font-display text-[clamp(2rem,6vw,4.5rem)] text-accent">✦</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="container-x mt-10 flex flex-col gap-4 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {profile.name}. All rights reserved.</p>
    <p>Built with Astro + GSAP · <span class="text-accent">hishivam.com</span></p>
    <a href="#main" data-to-top class="group inline-flex items-center gap-2 text-fg">
      back to top <span class="inline-block transition-transform group-hover:-translate-y-1">↑</span>
    </a>
  </div>
</footer>
