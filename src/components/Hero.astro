---
import { profile } from "@/data/profile";
import { allSkills } from "@/data/skills";

const chars = (word: string) => [...word];
const meta = [
  { k: "based in", v: "Ludhiana, IN" },
  { k: "focus", v: profile.facts.specialization },
  { k: "core", v: allSkills.slice(0, 3).join(" · ") },
  { k: "local time", v: "--:--", clock: true },
];
---

<section data-hero class="relative isolate flex min-h-[100svh] flex-col overflow-hidden pt-24 sm:pt-28">
  <canvas data-hero-canvas class="hero-canvas absolute inset-0 -z-10 size-full" aria-hidden="true"></canvas>

  <div data-hero-content class="container-x relative flex flex-1 flex-col justify-center pb-10">
    <p data-hero-fade class="mb-6 flex items-center gap-3 font-mono text-xs text-muted sm:mb-8">
      <span class="pulse-dot"></span>
      <span><span class="text-accent">[200 OK]</span> available for new projects</span>
    </p>

    <h1 data-hero-title class="font-display font-bold leading-[0.88] tracking-[-0.04em] select-none" aria-label={profile.name}>
      <span class="block text-[clamp(3.6rem,17vw,13.5rem)]" aria-hidden="true">
        {chars(profile.firstName).map((c) => <span class="hero-char" data-hero-char data-c={c}>{c}</span>)}
      </span>
      <span class="block text-[clamp(3.6rem,17vw,13.5rem)] sm:pl-[0.6em]" aria-hidden="true">
        {
          chars(profile.lastName).map((c) => (
            <span class="hero-char text-outline" data-hero-char data-c={c}>
              {c}
            </span>
          ))
        }
        <span class="hero-char text-accent" data-hero-char data-c=".">.</span>
      </span>
    </h1>

    <div class="mt-8 grid gap-8 sm:mt-10 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-xl">
        <p data-hero-fade class="font-mono text-sm sm:text-base">
          <span class="mr-2 text-accent">&gt;</span>
          <span data-role-typer>{profile.roles[0]}</span><span class="caret"></span>
        </p>
        <p data-hero-fade class="mt-4 text-base text-muted sm:text-lg">{profile.summary}</p>
        <div data-hero-fade class="mt-7 flex flex-wrap gap-3">
          <a href="#projects" class="btn btn-primary" data-cursor="scroll"><span>View projects</span><span class="arrow">↓</span></a>
          <a href="#contact" class="btn btn-ghost" data-cursor="say hi"><span>Get in touch</span><span class="arrow">→</span></a>
        </div>
      </div>

      <a href="#projects" data-hero-fade class="hidden items-center gap-3 self-end font-mono text-xs text-muted lg:flex" aria-label="Scroll to projects">
        <span class="scroll-cue-line block h-12 w-px bg-line"></span>
        scroll
      </a>
    </div>
  </div>

  <dl data-hero-fade class="container-x grid grid-cols-2 gap-px pb-6 sm:pb-8 md:grid-cols-4">
    {
      meta.map((m) => (
        <div class="border-t border-line pt-3 pr-3">
          <dt class="label !text-[0.65rem]">{m.k}</dt>
          <dd class="mt-1 truncate font-mono text-xs sm:text-sm" {...(m.clock ? { "data-clock": "" } : {})}>
            {m.v}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
