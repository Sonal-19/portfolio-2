---
import { profile } from "@/data/profile";

const links = [
  { href: "/#projects", label: "Projects", id: "projects" },
  { href: "/#experience", label: "Experience", id: "experience" },
  { href: "/#stack", label: "Stack", id: "stack" },
  { href: "/#about", label: "About", id: "about" },
  { href: "/#contact", label: "Contact", id: "contact" },
];
---

<header data-nav class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4">
  <div class="nav-inner mx-auto flex items-center justify-between gap-3 rounded-full py-2 pr-2 pl-4 sm:pl-5">
    <a href="/" class="group flex items-center gap-1 font-mono text-sm font-medium" aria-label="Home">
      <span class="text-accent">~/</span><span>{profile.firstName.toLowerCase()}</span><span
        class="caret !h-[0.9em] !w-[0.45em]"></span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            data-nav-link={l.id}
            data-scramble-hover
            class="nav-link relative font-mono text-xs text-muted transition-colors hover:text-fg"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle colour theme"
        class="grid size-10 place-items-center rounded-full border border-line text-muted transition-colors hover:text-fg"
      >
        <svg viewBox="0 0 24 24" class="hidden size-4 dark:block" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
        </svg>
        <svg viewBox="0 0 24 24" class="size-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <a href="/#contact" class="btn btn-primary hidden !py-2.5 sm:inline-flex">
        <span>Hire me</span><span class="arrow">→</span>
      </a>
      <button
        type="button"
        data-menu-open
        aria-label="Open menu"
        aria-expanded="false"
        class="grid size-10 place-items-center rounded-full bg-fg text-bg lg:hidden"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 8h16M4 16h10"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: circular clip-path reveal from the menu button -->
<div data-menu class="mobile-menu fixed inset-0 z-[70] flex flex-col bg-surface lg:hidden" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="container-x flex items-center justify-between pt-5">
    <p class="label">// navigate</p>
    <button
      type="button"
      data-menu-close
      aria-label="Close menu"
      class="grid size-10 place-items-center rounded-full bg-fg text-bg"
    >
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <nav class="container-x flex flex-1 flex-col justify-center gap-2" aria-label="Mobile">
    {
      links.map((l, i) => (
        <a href={l.href} data-menu-link class="group flex items-baseline gap-4 overflow-hidden py-1">
          <span class="font-mono text-xs text-accent">0{i + 1}</span>
          <span class="font-display text-[clamp(2.4rem,11vw,4.5rem)] font-semibold leading-[1.05] tracking-tight">
            {l.label}
          </span>
        </a>
      ))
    }
  </nav>
  <div class="container-x flex flex-wrap gap-x-5 gap-y-2 pb-8 font-mono text-xs text-muted">
    <a href={`mailto:${profile.email}`} class="text-fg">{profile.email}</a>
    <a href={`https://wa.me/${profile.whatsapp}`} target="_blank" rel="noopener" class="text-[#25d366]">WhatsApp</a>
    {profile.socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
  </div>
</div>
